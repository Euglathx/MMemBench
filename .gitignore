# ==================== Python ====================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Translations
*.mo
*.pot

# ==================== Jupyter Notebooks ====================
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.ipynb_checkpoints/

# ==================== IDE & Editors ====================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.*.swp

# Emacs
*~
\#*\#
.#*

# Spyder
.spyproject
.spyderproject

# ==================== OS Generated ====================
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~

# ==================== Environment ====================
# Virtual environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# Environment variables (IMPORTANT: Contains API keys!)
.env
.env.local
.env.*.local
*.env
config.local.yaml
secrets.yaml

# API Keys and Credentials (NEVER COMMIT!)
**/api_key*
**/apikey*
**/*_key.txt
**/*_key.json
credentials.json
credentials.yaml
service_account.json
*.pem
*.key

# ==================== Data & Datasets ====================
# Main data directory (too large, provide download instructions)
data/
!data/sample/
!data/README.md

# Downloaded datasets
MSCOCO/
MSCOCO14/
VisualGenome/
VisualCommenReasnoning/
VisualCommonsenseReasoning/
VCR/

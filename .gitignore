# ==================== Generated Files ====================
# Generated task outputs (regenerated each run)
generated_tasks/
generated_tasks_v2/
generated_tasks_unified/
!generated_tasks_v2/README.md
!generated_tasks_v2/sample/

# ==================== Experiment Outputs ====================
# Logs (keep structure, ignore contents)
simulator_test_log/*
!simulator_test_log/README.md
!simulator_test_log/.gitkeep

# Results
results/
batch_test_results/
experiment_images/
output/
outputs/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
temp/
tmp/

# ==================== Model Weights ====================
# PyTorch model weights
*.pt
*.pth
*.ckpt
*.safetensors

# TensorFlow
*.h5
saved_model/
checkpoints/

# ONNX
*.onnx

# Hugging Face models (downloaded at runtime)
models/
!models/__init__.py
!models/*.py

# ==================== Logs ====================
*.log
logs/
*.out
*.err
nohup.out

# ==================== Documentation Build ====================
docs/_build/
site/
.mkdocs/

# ==================== Misc ====================
# Backup files
*.bak
*.orig
*.backup

# Debug files
debug/
*.debug

# Profile files
*.prof
*.lprof

# Test artifacts
test_output/
test_results/
.benchmarks/

# Memory dumps
*.dump
core
core.*

# Analysis reports (can regenerate)
MISSING_FILES_ANALYSIS.md

# ==================== Project Specific ====================
# Human annotations (optional - may contain sensitive data)
# human_annotations/
# !human_annotations/README.md
# !human_annotations/guidelines/

# Run scripts with local paths
run_local_*.sh
run_local_*.bat
local_config.yaml

# Experiment-specific configs (may contain API keys)
experiment_configs/
!experiment_configs/template.yaml

# ==================== Keep These Files ====================
# Empty directories (use .gitkeep to preserve structure)
!**/.gitkeep
